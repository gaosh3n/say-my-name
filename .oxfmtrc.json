{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "ignorePatterns": [
        "node_modules/**",
        "dist/**",
        "out/**",
        "coverage/**",
        "release/**",
        ".vite/**"
    ]
}
